<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Invoicing{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2214%22>🧾</text></svg>">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="topbar">
    <a class="brand" href="{{ path('invoice_index') }}">🧾 Invoicing</a>
    <nav>
        <a href="{{ path('invoice_index') }}">Invoices</a>
        <a class="button button-primary" href="{{ path('invoice_new') }}">New invoice</a>
    </nav>
</header>

<main class="container">
    {% for label, messages in app.flashes(['success', 'error']) %}
        {% for message in messages %}
            <div class="flash flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

{% block javascripts %}{% endblock %}
</body>
</html>
